# =====================================================================
# UniPlanner — Configurazione Variabili d'Ambiente & Segreti di Sicurezza
# ATTENZIONE: Questo file è solo un template di esempio.
# Non inserire credenziali reali in questo file!
# Copia questo file in '.env' e imposta i valori reali (il file .env è ignorato da Git).
# =====================================================================

# Configurazione Ambiente Server
NODE_ENV=production
PORT=3000

# Chiave crittografica per la generazione e verifica dei token JWT (min. 32 caratteri)
JWT_SECRET=inserisci_una_stringa_casuale_e_sicura_di_almeno_32_caratteri

# URL base del Backend Node.js / Raspberry Pi (esposto tramite Ngrok o reverse proxy)
VITE_BACKEND_URL=https://shabby-myself-gleeful.ngrok-free.dev/api

# Chiavi Stripe per la gestione abbonamenti PRO (ESCLUSIVAMENTE LATO SERVER)
STRIPE_SECRET_KEY=sk_live_tuachiavesegretastripe
STRIPE_WEBHOOK_SECRET=whsec_tuosegretowebhookstripe

# Google Gemini API Key per l'Assistente allo Studio (LATO SERVER / PROXY OPZIONALE)
GEMINI_API_KEY=AIzaSy_tuachiaveapigeminiserverside

# Origini CORS autorizzate (separate da virgola)
ALLOWED_ORIGINS=https://uniplanner-web.vercel.app,http://localhost:5173
